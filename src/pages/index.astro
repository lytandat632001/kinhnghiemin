---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProductGrid from "../components/ProductGrid.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import BlogCard from "../components/BlogCard.astro";
import FaqList from "../components/FaqList.astro";
import { getCollection } from "astro:content";
import { site } from "../config/site";

const latestPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Hero
    title="Bao bì in dấu ấn riêng cho thương hiệu của bạn"
    subtitle="Xưởng in hộp, túi, ly và decal theo nhu cầu. Được tư vấn quy cách, hỗ trợ thiết kế đơn giản và báo giá trước khi in."
  />
  <ProductGrid />
  <section class="studio-section">
    <div class="container studio-grid">
      <div class="studio-copy">
        <span class="section-badge">Từ ý tưởng đến thành phẩm</span>
        <h2>Bạn có ý tưởng, xưởng cùng bạn hoàn thiện phần in ấn</h2>
        <p>Chưa rõ chọn chất liệu nào, cần kích thước ra sao hay mới có ý tưởng thiết kế? Hãy mô tả nhu cầu. Xưởng sẽ trao đổi phương án hộp, túi, ly hoặc decal phù hợp trước khi báo giá.</p>
        <a href="/bao-gia" class="btn btn-primary">Gửi yêu cầu tư vấn</a>
      </div>
      <div class="studio-points">
        <div><span>01</span><p>Tư vấn sản phẩm, chất liệu và quy cách theo mục đích sử dụng.</p></div>
        <div><span>02</span><p>Hỗ trợ thiết kế đơn giản hoặc trao đổi trên file bạn đã có.</p></div>
        <div><span>03</span><p>Thống nhất nội dung và chi phí trước khi tiến hành in.</p></div>
      </div>
    </div>
  </section>
  <ProcessSteps />

  {latestPosts.length > 0 && (
    <section class="latest-posts">
      <div class="container">
        <div class="section-head">
          <span class="section-badge">Blog</span>
          <h2>Bài viết mới</h2>
          <p>Kinh nghiệm chọn bao bì, chất liệu và chuẩn bị thiết kế trước khi in.</p>
        </div>
        <div class="blog-grid">
          {latestPosts.map((post) => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
            />
          ))}
        </div>
        <div class="view-all">
          <a href="/blog" class="btn btn-outline btn-lg">Xem tất cả bài viết →</a>
        </div>
      </div>
    </section>
  )}

  <FaqList />
  <section class="contact-cta">
    <div class="container contact-cta-inner">
      <div>
        <span class="section-badge">Kết nối với xưởng</span>
        <h2>Đang cần in hộp, túi, ly hoặc decal?</h2>
        <p>Gọi điện, nhắn Zalo, gửi email hoặc để lại yêu cầu báo giá. Xưởng sẽ liên hệ để trao đổi nhu cầu của bạn.</p>
      </div>
      <div class="contact-actions">
        <a class="btn btn-primary" href="/bao-gia">Yêu cầu báo giá</a>
        <a class="btn btn-outline" href={`tel:${site.phone}`}>Gọi {site.phoneDisplay}</a>
        <a class="text-link" href={`https://zalo.me/${site.zalo}`} target="_blank" rel="noopener">Nhắn Zalo →</a>
        <a class="text-link" href={`mailto:${site.email}`}>Gửi email →</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .latest-posts {
    padding: var(--space-20) 0;
    background: var(--color-bg-soft);
  }

  .section-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-12);
  }

  .section-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .section-head h2 { margin-bottom: var(--space-3); }
  .section-head p { color: var(--color-text-muted); font-size: 1.05rem; }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .view-all {
    text-align: center;
    margin-top: var(--space-10);
  }

  .studio-section {
    padding: var(--space-20) 0;
    background: var(--color-bg-soft);
  }

  .studio-grid {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: var(--space-12);
    align-items: center;
  }

  .studio-copy h2 { margin: var(--space-4) 0; }
  .studio-copy p { color: var(--color-text-muted); margin-bottom: var(--space-6); max-width: 620px; }

  .studio-points { display: grid; gap: var(--space-4); }
  .studio-points div {
    display: flex;
    align-items: flex-start;
    gap: var(--space-4);
    padding: var(--space-5);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  .studio-points span { color: var(--color-primary); font-weight: 800; }
  .studio-points p { color: var(--color-text-soft); }

  .contact-cta { padding: var(--space-16) 0; background: #f4f7fb; }
  .contact-cta-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-10);
  }
  .contact-cta h2 { margin: var(--space-4) 0 var(--space-3); }
  .contact-cta p { color: var(--color-text-muted); max-width: 650px; }
  .contact-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); align-items: center; min-width: 230px; }
  .text-link { font-weight: 700; padding: var(--space-2); }

  @media (max-width: 760px) {
    .studio-grid { grid-template-columns: 1fr; gap: var(--space-8); }
    .contact-cta-inner { align-items: flex-start; flex-direction: column; }
    .contact-actions { min-width: 0; }
  }
</style>
