---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import ProductGrid from "../components/ProductGrid.astro";
import ProcessSteps from "../components/ProcessSteps.astro";
import BlogCard from "../components/BlogCard.astro";
import FaqList from "../components/FaqList.astro";
import { getCollection } from "astro:content";

const latestPosts = (await getCollection("blog"))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <Hero
    title="Giải pháp in ấn cho quán cà phê, cửa hàng và doanh nghiệp"
    subtitle="Tư vấn chọn chất liệu, quy cách in, số lượng phù hợp với nhu cầu thực tế — giúp bạn tiết kiệm chi phí mà vẫn đẹp."
  />
  <ProductGrid />
  <ProcessSteps />

  {latestPosts.length > 0 && (
    <section class="latest-posts">
      <div class="container">
        <div class="section-head">
          <span class="section-badge">Blog</span>
          <h2>Bài viết mới</h2>
          <p>Kiến thức tư vấn in ấn dành cho chủ quán và doanh nghiệp.</p>
        </div>
        <div class="blog-grid">
          {latestPosts.map((post) => (
            <BlogCard
              slug={post.id}
              title={post.data.title}
              description={post.data.description}
              pubDate={post.data.pubDate}
              tags={post.data.tags}
            />
          ))}
        </div>
        <div class="view-all">
          <a href="/blog" class="btn btn-outline btn-lg">Xem tất cả bài viết →</a>
        </div>
      </div>
    </section>
  )}

  <FaqList />
</BaseLayout>

<style>
  .latest-posts {
    padding: var(--space-20) 0;
    background: var(--color-bg-soft);
  }

  .section-head {
    text-align: center;
    max-width: 680px;
    margin: 0 auto var(--space-12);
  }

  .section-badge {
    display: inline-block;
    padding: 0.35rem 0.85rem;
    background: var(--color-primary-light);
    color: var(--color-primary);
    border-radius: var(--radius-full);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: var(--space-4);
  }

  .section-head h2 { margin-bottom: var(--space-3); }
  .section-head p { color: var(--color-text-muted); font-size: 1.05rem; }

  .blog-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: var(--space-6);
  }

  .view-all {
    text-align: center;
    margin-top: var(--space-10);
  }
</style>