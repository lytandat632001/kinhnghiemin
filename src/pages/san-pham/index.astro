---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductGrid from "../../components/ProductGrid.astro";
---

<BaseLayout
  title="Sản phẩm in ấn — Kinh Nghiệm In"
  description="Xem các nhóm sản phẩm xưởng nhận in: hộp giấy, túi giấy, ly in logo, decal và tem nhãn."
>
  <section class="page-hero">
    <div class="container">
      <h1>Sản phẩm in ấn</h1>
      <p>Hộp, túi, ly, decal và các sản phẩm in theo yêu cầu. Chưa rõ quy cách? Hãy gửi nhu cầu để được tư vấn.</p>
    </div>
  </section>

  <ProductGrid />
</BaseLayout>

<style>
  .page-hero {
    padding: var(--space-lg) 0;
    background: var(--color-primary-light);
    text-align: center;
  }

  .page-hero h1 {
    margin-bottom: var(--space-xs);
  }

  .page-hero p {
    color: var(--color-text-muted);
  }
</style>
