---
import BaseLayout from "../layouts/BaseLayout.astro";
import { products } from "../config/site";
---

<BaseLayout
  title="Yêu cầu báo giá — In Ấn Pro"
  description="Gửi yêu cầu báo giá in ấn. Tôi sẽ liên hệ lại trong thời gian sớm nhất."
>
  <section class="page-hero">
    <div class="container">
      <h1>Yêu cầu báo giá</h1>
      <p>Điền thông tin bên dưới, tôi sẽ liên hệ tư vấn và báo giá trong thời gian sớm nhất.</p>
    </div>
  </section>

  <section class="quote-body">
    <div class="container container-narrow">
      <form id="quote-form" class="quote-form" novalidate>
        <div class="form-row">
          <label for="name">Họ và tên <span class="req">*</span></label>
          <input type="text" id="name" name="name" required maxlength="100" />
        </div>

        <div class="form-row">
          <label for="phone">Số điện thoại <span class="req">*</span></label>
          <input type="tel" id="phone" name="phone" required maxlength="20" />
        </div>

        <div class="form-row">
          <label for="product">Loại sản phẩm <span class="req">*</span></label>
          <select id="product" name="product" required>
            <option value="">— Chọn loại sản phẩm —</option>
            {products.map((p) => (
              <option value={p.slug}>{p.name}</option>
            ))}
            <option value="khac">Khác / chưa xác định</option>
          </select>
        </div>

        <div class="form-row-2">
          <div class="form-row">
            <label for="size">Kích thước / quy cách</label>
            <input type="text" id="size" name="size" maxlength="200" placeholder="VD: 5x5cm, A4..." />
          </div>

          <div class="form-row">
            <label for="quantity">Số lượng dự kiến</label>
            <input type="text" id="quantity" name="quantity" maxlength="50" placeholder="VD: 1000" />
          </div>
        </div>

        <div class="form-row">
          <label for="message">Mô tả thêm</label>
          <textarea id="message" name="message" rows="5" maxlength="2000"
            placeholder="Mô tả nhu cầu, chất liệu mong muốn, thời gian cần hàng..."></textarea>
        </div>

        <div class="form-row consent">
          <label class="checkbox-label">
            <input type="checkbox" id="consent" name="consent" required />
            <span>Tôi đồng ý cung cấp thông tin để được tư vấn và báo giá.</span>
          </label>
        </div>

        <p class="form-note">
          File thiết kế (nếu có) sẽ được trao đổi qua Zalo hoặc email sau khi bạn gửi yêu cầu.
        </p>

        <button type="submit" class="btn btn-primary btn-block">Gửi yêu cầu</button>

        <div id="form-message" class="form-message" hidden></div>
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .page-hero {
    padding: var(--space-lg) 0;
    background: var(--color-primary-light);
    text-align: center;
  }

  .quote-body { padding: var(--space-xl) 0; }

  .container-narrow {
    max-width: 720px;
  }

  .quote-form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-lg);
  }

  .form-row { display: flex; flex-direction: column; gap: 0.4rem; }

  .form-row-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-md);
  }

  @media (max-width: 600px) {
    .form-row-2 { grid-template-columns: 1fr; }
  }

  .form-row label {
    font-weight: 600;
    font-size: 0.95rem;
  }

  .req { color: #dc2626; }

  input[type="text"],
  input[type="tel"],
  select,
  textarea {
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    font-family: inherit;
    font-size: 1rem;
    background: #fff;
    transition: border-color 0.2s, box-shadow 0.2s;
    width: 100%;
  }

  input:focus, select:focus, textarea:focus {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px rgba(30, 95, 191, 0.12);
  }

  textarea { resize: vertical; min-height: 100px; }

  .checkbox-label {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    font-weight: 400;
    cursor: pointer;
    font-size: 0.95rem;
  }

  .checkbox-label input { margin-top: 0.25rem; flex-shrink: 0; }

  .form-note {
    color: var(--color-text-muted);
    font-size: 0.9rem;
    padding: var(--space-xs) 0;
    border-top: 1px dashed var(--color-border);
    margin-top: var(--space-xs);
  }

  .btn-block { width: 100%; padding: 0.9rem; font-size: 1.05rem; }

  .form-message {
    padding: var(--space-sm);
    border-radius: var(--radius-sm);
    font-weight: 500;
    text-align: center;
  }

  .form-message.success {
    background: #dcfce7;
    color: #166534;
    border: 1px solid #86efac;
  }

  .form-message.error {
    background: #fee2e2;
    color: #991b1b;
    border: 1px solid #fca5a5;
  }
</style>
<script>
  import { initQuoteForm } from "../scripts/quote-form";
  initQuoteForm();
</script>