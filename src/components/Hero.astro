---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<section class="hero">
  <div class="container">
    <h1>{title}</h1>
    <p>{subtitle}</p>
    <div class="hero-cta">
      <a href="/bao-gia" class="btn btn-primary">Yêu cầu báo giá</a>
      <a href="/san-pham" class="btn btn-outline">Xem sản phẩm</a>
    </div>
  </div>
</section>

<style>
  .hero {
    padding: var(--space-xl) 0;
    background: var(--color-primary-light);
    text-align: center;
  }

  .hero h1 {
    max-width: 720px;
    margin: 0 auto var(--space-md);
  }

  .hero p {
    max-width: 620px;
    margin: 0 auto var(--space-lg);
    color: var(--color-text-muted);
    font-size: 1.1rem;
  }

  .hero-cta {
    display: flex;
    gap: var(--space-sm);
    justify-content: center;
    flex-wrap: wrap;
  }
</style>